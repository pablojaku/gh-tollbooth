#!/usr/bin/env -S python3 -I
"""gh-tollbooth: one polite, shared, read-only request stream to GitHub for every agent on a machine.

Talks to the GitHub API directly, with the login `gh` already has (or GH_TOKEN). Stdlib only,
Python 3.9+. Results go to stdout; progress goes to stderr.

  gh-tollbooth status                           rate-limit buckets + recent calls (free)
  gh-tollbooth call [--no-cache] -- api <args>  one read-only GitHub API request, throttled
  gh-tollbooth sweep QUERIES.tsv [--first N]    many repo searches, a few per GraphQL request

`call` takes `gh api`'s form: one endpoint (or graphql) with -X GET|HEAD, -f/-F key=value,
-H 'Accept: ...', -i and --silent. It prints GitHub's answer as it is: pipe it to jq to pick fields.

`sweep` reads one `slice<TAB>query` per line and prints one JSON row per repository found (stars,
language, topics, ..., plus the slice and query), 5 queries per request at the default --first 20.

Global options (before or after the command, before `--`): --as LABEL  --budget N
--budget caps the GitHub calls LABEL makes in 24 h. It is cooperative: it holds while every command
passes it, and can't stop an agent that drops it, picks another label or calls GitHub another way.
Exit codes: 0 ok; 1 no token, no answer from GitHub, an HTTP error answer or no state folder;
2 usage or a request gh-tollbooth refuses; 3 GitHub gave up on all or part of a request; 4 budget used up;
75 GitHub rate limit (stop and report the time); 76 busy or out of time (retry once later).

Trust boundary: an agent may choose the arguments, never the environment. Python runs in isolated
mode (-I), so PYTHONPATH can't put code into this process. The environment still picks the python3
(PATH), the token (GH_TOKEN) and a proxy that sees the token (HTTPS_PROXY with SSL_CERT_FILE), so
don't let agents put variable assignments in front of this command.
"""
from __future__ import annotations

import argparse
import datetime as dt
import io
import json
import os
import re
import sys
from contextlib import suppress
from http.client import responses as REASONS
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import tollbooth_core as core  # noqa: E402
import tollbooth_http as http  # noqa: E402
from tollbooth_core import EX_FAIL, EX_USAGE, TollboothError, clock_in, eprint  # noqa: E402
from tollbooth_guard import CallRequest, parse_call  # noqa: E402
from tollbooth_loop import Caller, StoppedOnAnswer  # noqa: E402
from tollbooth_sweep import read_queries, sweep  # noqa: E402
from tollbooth_throttle import Throttle  # noqa: E402

BUCKETS = ("graphql", "core", "search", "code_search")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def _count(value) -> str:
    """A number from GitHub's answer as text; anything else is "?" (text could carry terminal codes)."""
    return str(value) if isinstance(value, int) and not isinstance(value, bool) else "?"


def cmd_status(caller: Caller, a: argparse.Namespace) -> int:
    # Asked directly, not through the throttle: GitHub doesn't count rate_limit against any bucket,
    # and status is what you run while buckets are blocked (docs/adr/0001).
    resp = http.send("GET", "rate_limit", caller.token(), timeout=30)
    if resp.status != 200:
        hint = " (GitHub rejected the token: run `gh auth login`, or check GH_TOKEN)" if resp.status == 401 else ""
        raise TollboothError(f"GET rate_limit answered HTTP {resp.status}{hint}", EX_FAIL)
    try:
        res = json.loads(resp.body)["resources"]
        rows = [(b, res.get(b) or {}) for b in BUCKETS]
        lines = []
        for b, r in rows:
            reset = dt.datetime.fromtimestamp(r.get("reset", 0)).strftime("%H:%M:%S")
            lines.append(f"{b:13} {_count(r.get('remaining')):>6}/{_count(r.get('limit')):<6}  {reset}")
    except (ValueError, KeyError, TypeError, AttributeError, OverflowError, OSError, RecursionError):
        raise TollboothError("GET rate_limit: the answer is not GitHub's rate-limit document", EX_FAIL)
    print("bucket        remaining/limit  resets")
    for (b, _), line in zip(rows, lines):
        left = caller.throttle.blocked_for(b)
        print(line + (f"  BLOCKED until {clock_in(left, caller.throttle.clock)}" if left > 0 else ""))
    hour_ago = (dt.datetime.now() - dt.timedelta(hours=1)).isoformat(timespec="seconds")
    recent = [e for e in caller.throttle.entries() if len(e) >= 7 and e[0] >= hour_ago]
    counts: dict = {}
    for e in recent:
        counts[(e[1], e[3])] = counts.get((e[1], e[3]), 0) + 1
    print(f"\ngh-tollbooth calls in the last hour: {len(recent)}")
    for (label, bucket), n in sorted(counts.items(), key=lambda kv: -kv[1])[:15]:
        print(f"  {n:4}  {bucket:12} {label}")
    for e in recent[-a.last:] if a.last else []:
        print(f"  {e[0][11:]}  {e[1]:<16} {e[3]:<12} http={e[4]:<3} {e[5]:>5}s  {e[6][:70]}")
    return 0


def cmd_call(caller: Caller, a: argparse.Namespace) -> int:
    """One read-only request, as `gh api` would make it; GitHub's answer goes to stdout byte for byte."""
    req = parse_call(a.gh_args[1:] if a.gh_args[:1] == ["--"] else a.gh_args)
    if sys.stdout is None and not req.silent:  # `>&-`: the call would be charged and its answer lost
        raise TollboothError("stdout is closed, so GitHub's answer would be lost: redirect it, or pass --silent",
                             EX_USAGE)
    try:
        resp = caller.fetch(req.method, req.path, accept=req.accept, json_body=req.json_body)
    except ValueError as e:  # the guard let through something tollbooth_http refuses
        raise TollboothError(f"refused: {e}", EX_USAGE)
    except StoppedOnAnswer as e:  # a 502/504 or a rate limit: show GitHub's answer, then its exit code
        write_answer(e.answer, req)
        raise
    write_answer(resp, req)
    if 200 <= resp.status < 300:
        return 0
    eprint(f"gh-tollbooth: HTTP {resp.status} {REASONS.get(resp.status, '')}".rstrip())
    return EX_FAIL


def cmd_sweep(caller: Caller, a: argparse.Namespace) -> int:
    """Many repository searches; one JSON row per repository on stdout, progress on stderr."""
    queries = read_queries(a.queries)  # a refused file costs nothing
    if sys.stdout is None:  # `>&-`: every row would be lost
        raise TollboothError("stdout is closed, so the rows would be lost: redirect it to a file", EX_USAGE)
    sweep(caller, queries, a.first, sys.stdout)
    return 0


def write_answer(resp: http.Response, req: CallRequest) -> None:
    """The answer on stdout: with -i the status line and headers first; with --silent nothing."""
    if req.silent:
        return
    sys.stdout.flush()  # anything printed as text goes first
    out = sys.stdout.buffer
    if req.include:
        head = [f"HTTP/1.1 {resp.status} {REASONS.get(resp.status, '')}".rstrip()]
        head += [f"{_header_name(k)}: {v}" for k, v in resp.headers.items()]
        out.write("".join(CONTROL_RE.sub("?", line) + "\n" for line in head).encode("utf-8", "replace") + b"\n")
    out.write(resp.body)
    out.flush()


def _header_name(name: str) -> str:
    """x-ratelimit-remaining -> X-Ratelimit-Remaining, the way gh prints header names."""
    return "-".join(part.capitalize() for part in name.split("-"))


def count(text: str) -> int:
    n = int(text)
    if n < 0:
        raise argparse.ArgumentTypeError("must be 0 or more")
    return n


def build_parser() -> argparse.ArgumentParser:
    # allow_abbrev=False everywhere: argparse would otherwise read `--bud 5` as `--budget 5`
    common = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    common.add_argument("--as", dest="label", default=argparse.SUPPRESS, help="tag calls in the log")
    common.add_argument("--budget", type=int, default=argparse.SUPPRESS,
                        help="cooperative cap on GitHub calls for --as LABEL in 24 h")
    p = argparse.ArgumentParser(prog="gh-tollbooth", parents=[common], description=__doc__, allow_abbrev=False,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("status", parents=[common], allow_abbrev=False, help="buckets + recent calls (free)")
    s.add_argument("--last", type=count, default=8, help="recent calls to list (default 8)")
    s = sub.add_parser("call", parents=[common], allow_abbrev=False,
                       help="one read-only GitHub API request: call -- api <args>")
    s.add_argument("--no-cache", action="store_true", help="accepted and ignored: gh-tollbooth doesn't cache")
    s.add_argument("gh_args", nargs=argparse.REMAINDER, help="api ENDPOINT [options], as for `gh api`")
    s = sub.add_parser("sweep", parents=[common], allow_abbrev=False, help="batched GraphQL repo search")
    s.add_argument("queries", help="a .tsv file: one slice<TAB>query per line")
    s.add_argument("--first", type=int, default=20, help="results per query, 1 to 100 (default 20)")
    s.add_argument("--no-cache", action="store_true", help="accepted and ignored: gh-tollbooth doesn't cache")
    return p


def _reader_left() -> int:
    """The reader closed the pipe (`| head`). Not an error: stdout goes nowhere, so the flush at exit is quiet."""
    with suppress(OSError, ValueError):
        fd = sys.stdout.fileno()
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, fd)
        os.close(devnull)
    return 0


def main(argv=None) -> int:
    for stream in (sys.stdout, sys.stderr):  # text this locale can't encode (a logged query) prints as '?'
        if isinstance(stream, io.TextIOWrapper):
            stream.reconfigure(errors="replace")
    a = build_parser().parse_args(argv)
    label = getattr(a, "label", None) or os.environ.get("TOLLBOOTH_AS", "anon")
    budget = getattr(a, "budget", None)
    if not core.LABEL_RE.fullmatch(label):
        eprint("gh-tollbooth: --as LABEL may use only letters, digits, '.', '_' and '-' (max 40)")
        return EX_USAGE
    if budget is not None and label == "anon":
        eprint("gh-tollbooth: --budget needs a unique --as LABEL (calls are counted per label)")
        return EX_USAGE
    try:
        throttle = Throttle(core.STATE_DIR)
    except OSError as e:
        eprint(f"gh-tollbooth: can't create the state folder {core.STATE_DIR} ({e.strerror or e}); "
               "set TOLLBOOTH_STATE_DIR to a folder you can write to")
        return EX_FAIL
    caller = Caller(label, budget, throttle)
    handler = {"status": cmd_status, "call": cmd_call, "sweep": cmd_sweep}[a.cmd]
    try:
        code = handler(caller, a)
        if sys.stdout is not None:  # None when stdout was closed (`>&-`)
            sys.stdout.flush()  # a closed pipe shows here when the output was small
        return code
    except BrokenPipeError:
        return _reader_left()
    except TollboothError as e:
        eprint(f"gh-tollbooth: {e}")
        return e.code
    except http.NoToken as e:
        eprint(f"gh-tollbooth: {e}")
        return EX_FAIL
    except http.TransportError as e:
        eprint(f"gh-tollbooth: no answer from GitHub ({e})")
        return EX_FAIL
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
